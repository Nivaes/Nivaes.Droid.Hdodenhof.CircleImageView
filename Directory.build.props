<Project>
  <PropertyGroup>
    <Copyright>Copyright (c) Nivaes Systems S.L.</Copyright>
    <PackageProject>https://github.com/Nivaes/Nivaes.Droid.Hdodenhof.CircleImageView</PackageProject>
    <PackageLicenseExpression>MS-PL</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <Authors>Nivaes Systems</Authors>
    <Company>Nivaes Systems</Company>
    <Owners>Nivaes</Owners>
    <PackageReleaseNotes>https://www.nivaes.com</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/Nivaes/Nivaes.Droid.Hdodenhof.CircleImageView</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Product>$(AssemblyName) ($(TargetFramework))</Product>
    <NeutralLanguage>en</NeutralLanguage>
    <VersionPrefix>0.0.0</VersionPrefix>
    <VersionSuffix>-dev-0.0.1</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup>
    <_SupportedOSPlatformMacOSVersion>13.0</_SupportedOSPlatformMacOSVersion>

    <_SupportedOSPlatformiOSVersion>15.8</_SupportedOSPlatformiOSVersion>
    <_TargetPlatformiOSVersion>26.0</_TargetPlatformiOSVersion>

    <_SupportedOSPlatformMacCatalystVersion>15.0</_SupportedOSPlatformMacCatalystVersion>
    <_TargetPlatformMacCatalystVersion>26.0</_TargetPlatformMacCatalystVersion>

    <_SupportedOSPlatformTvOSVersion>15.8</_SupportedOSPlatformTvOSVersion>
    <_TargetPlatformTvOSVersion>26.0</_TargetPlatformTvOSVersion>

    <_SupportedOSPlatformAndroidVersion>24</_SupportedOSPlatformAndroidVersion>

    <!--<_SupportedOSPlatformWindowsVersion>10.0.22000.0</_SupportedOSPlatformWindowsVersion>-->
    <_TargetPlatformWinodwsMinVersion>10.0.19041.0</_TargetPlatformWinodwsMinVersion>
  </PropertyGroup>

  <PropertyGroup>
    <_AndroidTargetFrameworks>net10.0-android</_AndroidTargetFrameworks>
    <_SampleAndroidTargetFramework>net10.0-android</_SampleAndroidTargetFramework>
</PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
    <EnablePackageValidation>true</EnablePackageValidation>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);1591;1701;1702;1705;VSX1000</NoWarn>
    <GenerateDocumentationFile Condition=" '$(Configuration)' == 'Release' ">true</GenerateDocumentationFile>

    <DebugType>full</DebugType>
    <IsTestProject>$(MSBuildProjectName.Contains('UnitTest'))</IsTestProject>
  </PropertyGroup>

</Project>
