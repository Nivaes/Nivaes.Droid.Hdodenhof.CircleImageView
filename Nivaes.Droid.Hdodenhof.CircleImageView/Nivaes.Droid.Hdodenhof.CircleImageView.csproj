<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>$(_AndroidTargetFrameworks)</TargetFrameworks>
    <SupportedOSPlatformVersion>$(_SupportedOSPlatformAndroidVersion)</SupportedOSPlatformVersion>

    <AssemblyName>De.Hdodenhof.CircleImageView</AssemblyName>
    <RootNamespace>De.Hdodenhof.CircleImageView</RootNamespace>

    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <RunAOTAnalysis>true</RunAOTAnalysis>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'!='Debug'">
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Images\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <Description>Binding library of https://github.com/hdodenhof/CircleImageView</Description>
    <PackageId>Nivaes.Droid.Hdodenhof.CircleImageView</PackageId>
    <PackageTags>xamarin;android;nivaes;Hdodenhof;CircleImageView</PackageTags>
  </PropertyGroup>

</Project>
